  (74, 'Good Mornings', 'Barbell Good Mornings',
   'Place barbell on upper traps. Stand with feet hip-width apart. Hinge at hips while keeping slight knee bend. Lower torso until parallel to ground, then return by driving hips forward.',
   NULL),

  -- Additional Back Exercises
  (75, 'T-Bar Rows', 'Landmine Rows',
   'Straddle T-bar with chest up and knees slightly bent. Grip handles and pull bar to chest, squeezing shoulder blades. Lower with control. Keep torso stable throughout.',
   NULL),

  (76, 'Cable Low Rows', 'Low Cable Rows',
   'Sit at low cable with feet on platform. Grip handle with arms extended. Pull handle to lower chest while retracting shoulder blades. Keep torso upright with slight backward lean.',
   NULL),

  (77, 'Machine Rows', 'Seated Machine Row',
   'Sit in rowing machine with chest against pad. Grip handles and pull back, squeezing shoulder blades together. Keep elbows close to body and return with control.',
   NULL),

  (78, 'Inverted Rows', 'Bodyweight Rows, Australian Pull-ups',
   'Lie under bar set at hip height. Grip bar with overhand grip, body straight. Pull chest to bar by squeezing shoulder blades. Lower with control. Adjust angle for difficulty.',
   NULL),

  (79, 'Hyperextensions', 'Back Extensions',
   'Position yourself in hyperextension machine with hips at pad edge. Cross arms over chest or behind head. Lower torso until you feel stretch in hamstrings. Raise back up using glutes and lower back.',
   NULL),

  (80, 'Reverse Hyperextensions', 'Reverse Back Extensions',
   'Lie face down on bench with hips at edge, holding bench for support. Keep legs straight and raise them up by squeezing glutes. Lower with control. Targets glutes and hamstrings.',
   NULL),

  (81, 'Wide Grip Lat Pulldowns', 'Wide Lat Pulldown',
   'Sit at pulldown machine with wide overhand grip. Pull bar to upper chest while squeezing shoulder blades. Keep torso upright and return with control.',
   NULL),

  (82, 'Close Grip Lat Pulldowns', 'Narrow Lat Pulldown',
   'Use narrow grip attachment on pulldown machine. Pull to chest while squeezing lats and middle traps. Keep elbows close to body.',
   NULL),

  -- Additional Chest Exercises
  (83, 'Decline Barbell Bench Press', 'Decline Bench Press',
   'Set bench to decline angle, secure feet. Grip bar slightly wider than shoulders. Lower bar to lower chest with control. Press up focusing on lower chest engagement.',
   NULL),

  (84, 'Incline Dumbbell Flyes', 'Incline Flyes',
   'Set bench to incline. Hold dumbbells above chest with slight elbow bend. Lower in wide arc until chest stretch is felt. Return using same path, squeezing upper chest.',
   NULL),

  (85, 'Decline Dumbbell Flyes', 'Decline Flyes',
   'Set bench to decline. Perform dumbbell flyes targeting lower chest fibers. Maintain slight elbow bend and control throughout range of motion.',
   NULL),

  (86, 'Cable Chest Flyes', 'Cable Flyes',
   'Stand between cable machines with handles at chest height. Step forward with slight lean. Bring handles together in front of chest with slight elbow bend. Return with control.',
   NULL),

  (87, 'Dips', 'Parallel Bar Dips',
   'Grip parallel bars and support body weight. Lower by bending elbows until shoulders are below elbows. Press back up to starting position. Keep body upright for chest focus.',
   NULL),

  (88, 'Chest Press Machine', 'Machine Chest Press',
   'Sit in machine with back against pad. Grip handles at chest level. Press forward until arms are extended. Return with control. Keep shoulders back against pad.',
   NULL),

  -- Additional Shoulder Exercises
  (89, 'Front Raises', 'Anterior Raises',
   'Hold dumbbells at sides with slight forward lean. Raise one or both arms forward to shoulder height. Keep slight elbow bend and control throughout. Lower slowly.',
   NULL),

  (90, 'Upright Rows', 'High Pulls',
   'Hold barbell with narrow overhand grip. Pull bar up along body to chest level, leading with elbows. Keep bar close to body and lower with control.',
   NULL),

  (91, 'Shrugs', 'Barbell Shrugs, Dumbbell Shrugs',
   'Hold weight with arms at sides. Shrug shoulders straight up toward ears, squeezing traps at top. Lower slowly. Avoid rolling shoulders forward or backward.',
   NULL),

  (92, 'Cable Lateral Raises', 'Cable Side Raises',
   'Stand sideways to cable machine with handle at side. Raise arm out to side until parallel to ground. Lower with control. Cable provides constant tension.',
   NULL),

  (93, 'Bent Over Lateral Raises', 'Rear Delt Raises',
   'Bend forward at hips with dumbbells hanging down. Raise weights out to sides while squeezing rear delts. Keep slight elbow bend and control movement.',
   NULL),

  -- Additional Arm Exercises
  (94, 'Preacher Curls', 'Preacher Bench Curls',
   'Sit at preacher bench with armpits at top of pad. Hold barbell or dumbbells with underhand grip. Curl weight up while keeping wrists straight. Lower with control.',
   NULL),

  (95, 'Cable Bicep Curls', 'Cable Curls',
   'Stand at cable machine with handle attached to low pulley. Curl handle up while keeping elbows at sides. Squeeze biceps at top and lower with control.',
   NULL),

  (96, 'Concentration Curls', 'Seated Concentration Curls',
   'Sit on bench with dumbbell in one hand, elbow braced against inner thigh. Curl weight up focusing on bicep contraction. Lower slowly and maintain strict form.',
   NULL),

  (97, 'Cable Tricep Overhead Extension', 'Cable Overhead Tricep Extension',
   'Face away from high cable with rope attachment. Keep elbows forward and extend arms overhead. Return with control, feeling stretch in triceps.',
   NULL),

  (98, 'Skull Crushers', 'Lying Tricep Extensions',
   'Lie on bench holding barbell or dumbbells over chest. Keep elbows stationary and lower weight toward forehead. Extend arms back to starting position using triceps.',
   NULL),

  (99, 'Kickbacks', 'Tricep Kickbacks',
   'Bend forward with dumbbell in one hand, upper arm parallel to ground. Extend forearm back until arm is straight. Return with control, keeping upper arm still.',
   NULL),

  (100, 'Wrist Curls', 'Forearm Curls',
   'Sit with forearms on bench, wrists hanging over edge. Hold light weight and curl wrists up and down. Targets forearm flexors and extensors.',
   NULL),

  -- Machine & Cable Variations
  (101, 'Lat Pulldown - Reverse Grip', 'Underhand Lat Pulldown',
   'Use underhand grip on lat pulldown. Pull bar to chest while squeezing lats. This variation increases bicep involvement.',
   NULL),

  (102, 'Cable Crossovers', 'Cable Chest Crossovers',
   'Stand between high cables with handles. Step forward and bring handles together in front of chest with slight forward lean. Focus on squeezing chest.',
   NULL),

  (103, 'Pec Deck', 'Chest Fly Machine',
   'Sit in pec deck machine with arms against pads. Bring arms together in front of chest, squeezing pecs. Return with control.',
   NULL),

  (104, 'Machine Shoulder Press', 'Seated Machine Press',
   'Sit in shoulder press machine with back against pad. Grip handles at shoulder level. Press up until arms are extended. Lower with control.',
   NULL),

  (105, 'Cable Shrugs', 'Cable Trap Shrugs',
   'Stand at cable machine with bar attachment at low setting. Shrug shoulders up while holding cable handle. Provides different resistance curve than free weights.',
   NULL),

  -- Olympic & Power Movements
  (106, 'Power Clean', 'Clean',
   'Start with bar on ground in deadlift position. Pull bar up explosively while keeping it close to body. Catch bar at shoulder level in front squat position. Advanced movement requiring proper coaching.',
   NULL),

  (107, 'Hang Clean', 'Hang Power Clean',
   'Start with bar at hip level. Explosively extend hips and pull bar up, catching at shoulder level. Less technical than full clean from floor.',
   NULL),

  (108, 'Push Press', 'Overhead Push Press',
   'Hold barbell at shoulder level. Dip knees slightly then drive up while pressing bar overhead. Uses leg drive to assist overhead press.',
   NULL),

  -- Additional Functional Movements
  (109, 'Farmer Walks', 'Farmers Carry',
   'Hold heavy dumbbells or farmers walk handles at sides. Walk forward with good posture, keeping core tight. Excellent for grip strength and core stability.',
   NULL),

  (110, 'Suitcase Carry', 'Single Side Carry',
   'Hold heavy dumbbell in one hand at side. Walk forward maintaining upright posture. Challenges core stability and grip strength unilaterally.',
   NULL),

  (111, 'Bear Crawl', 'Quadruped Crawl',
   'Start on hands and knees, lift knees slightly off ground. Crawl forward using opposite hand and foot. Keep hips low and core engaged.',
   NULL),

  (112, 'Kettlebell Swings', 'KB Swings',
   'Stand with feet wider than shoulders, kettlebell in front. Hinge at hips and swing kettlebell between legs. Drive hips forward explosively, swinging weight to chest height.',
   NULL),

  (113, 'Single Arm Kettlebell Swings', 'One Arm KB Swings',
   'Perform kettlebell swing with one arm while other arm moves for balance. Switch arms each set. Challenges core stability more than two-handed version.',
   NULL),

  -- Isolation & Accessory Work
  (114, 'Calf Press on Leg Press', 'Leg Press Calf Raises',
   'Sit in leg press machine with just balls of feet on platform. Press platform using only calf muscles. Hold squeeze at top and lower for full stretch.',
   NULL),

  (115, 'Donkey Calf Raises', 'Bent Over Calf Raises',
   'Bend forward at 90 degrees with partner on back or using machine. Rise onto toes squeezing calves. Provides excellent stretch and contraction.',
   NULL),

  (116, 'Reverse Curls', 'Overhand Barbell Curls',
   'Hold barbell with overhand grip, hands shoulder-width apart. Curl bar up keeping elbows at sides. Targets brachialis and forearms more than regular curls.',
   NULL),

  (117, 'Cable Hammer Curls', 'Rope Hammer Curls',
   'Use rope attachment on low cable. Curl rope up with neutral grip, squeezing biceps and forearms at top. Lower with control.',
   NULL),

  (118, 'Zottman Curls', 'Rotating Dumbbell Curls',
   'Curl dumbbells up with underhand grip. At top, rotate to overhand grip and lower slowly. Rotate back to underhand at bottom. Targets biceps and forearms.',
   NULL),

  -- Additional Back Variations
  (119, 'Wide Grip Pull-ups', 'Wide Grip Pullups',
   'Use wider than normal grip on pull-up bar. Pull up until chin clears bar, focusing on lat engagement. Lower with control.',
   NULL),

  (120, 'Neutral Grip Pull-ups', 'Parallel Grip Pull-ups',
   'Use parallel handles for neutral grip. Pull up until chin clears handles. This grip is often easier on shoulders and wrists.',
   NULL),

  (121, 'Chest Supported Rows', 'Machine Supported Rows',
   'Use chest supported row machine or incline bench. Pull handles to chest while squeezing shoulder blades. Eliminates lower back involvement.',
   NULL),

  (122, 'Landmine Rows', 'Single Arm Landmine Rows',
   'Position barbell in landmine setup. Stand over bar with one foot forward. Pull bar to chest with one arm, squeezing lat and rhomboid.',
   NULL),

  -- Lower Body Unilateral & Accessories
  (123, 'Step Downs', 'Negative Step Ups',
   'Stand on box or bench. Step down with one leg, controlling descent with other leg. Step back up and repeat. Excellent for knee stability.',
   NULL),

  (124, 'Curtsy Lunges', 'Curtsy Squats',
   'Step one leg behind and across the other leg. Lower into lunge position. Return to standing and repeat. Targets glutes from different angle.',
   NULL),

  (125, 'Lateral Lunges', 'Side Lunges',
   'Step wide to one side, bending that knee while keeping other leg straight. Push off bent leg to return to center. Targets inner thighs and glutes.',
   NULL),

  (126, 'Single Leg Romanian Deadlift', 'Single Leg RDL',
   'Stand on one leg holding dumbbell. Hinge at hip while extending free leg behind. Lower weight while maintaining balance. Return to standing.',
   NULL),

  (127, 'Pistol Squats', 'Single Leg Squats',
   'Stand on one leg with other leg extended forward. Lower into deep squat on one leg. Return to standing. Very challenging bodyweight movement.',
   NULL),

  -- Additional Chest Variations
  (128, 'Cable Chest Press', 'Cable Press',
   'Stand between cables set at chest height. Press handles forward until arms are extended. Return with control. Provides constant tension throughout range.',
   NULL),

  (129, 'Svend Press', 'Plate Squeeze Press',
   'Hold weight plate between palms at chest level. Squeeze plate while pressing it away from chest. Return with control while maintaining squeeze.',
   NULL),

  (130, 'Pullovers', 'Dumbbell Pullovers',
   'Lie on bench with dumbbell held above chest. Lower weight behind head in arc motion, feeling stretch in chest and lats. Return to starting position.',
   NULL),

  -- Core & Stability
  (131, 'Pallof Press', 'Anti-Rotation Core Exercise',
   'Stand sideways to cable machine at chest height. Hold handle at chest and press straight out, resisting rotation. Hold and return. Excellent anti-rotation exercise.',
   NULL),

  (132, 'Suitcase Holds', 'Unilateral Carry Hold',
   'Hold heavy dumbbell in one hand at side. Stand tall maintaining posture against the uneven load. Challenges core stability and grip strength.',
   NULL),

  (133, 'Single Arm Farmer Walk', 'Unilateral Farmers Walk',
   'Hold heavy weight in one hand and walk forward. Maintain upright posture and resist leaning. Switch sides each set.',
   NULL),

  (134, 'Turkish Get-up Partial', 'Half Turkish Get-up',
   'Perform first half of Turkish get-up, stopping at seated position. Focus on smooth movement while keeping weight overhead.',
   NULL),

  (135, 'Hollow Body Hold', 'Hollow Hold',
   'Lie on back, press lower back to ground. Lift shoulders and legs off ground, holding hollow position. Keep arms extended and breathe normally.',
   NULL),

  (136, 'V-Ups', 'Jackknife Sit-ups',
   'Lie on back with arms extended overhead. Simultaneously lift legs and torso, reaching hands toward feet. Lower with control.',
   NULL),

  (137, 'Dragon Flags', 'Bruce Lee Flags',
   'Lie on bench gripping behind head. Lift entire body up keeping it straight. Lower slowly with control. Extremely challenging core exercise.',
   NULL),

  -- Olympic Lifting Accessories
  (138, 'Romanian Deadlift - Single Leg', 'Single Leg RDL',
   'Hold barbell or dumbbells. Stand on one leg, hinge at hip while lowering weight. Keep standing leg slightly bent and maintain balance.',
   NULL),

  (139, 'Sumo Deadlift', 'Wide Stance Deadlift',
   'Stand with wide stance, toes turned out. Grip bar with hands inside legs. Pull bar up by extending hips and knees simultaneously. Keep chest up.',
   NULL),

  (140, 'Trap Bar Deadlift', 'Hex Bar Deadlift',
   'Stand inside trap bar with neutral grip on handles. Deadlift with more upright torso position. Often easier on lower back than conventional deadlift.',
   NULL),

  -- Additional Functional & Athletic Movements
  (141, 'Box Jumps', 'Plyometric Box Jumps',
   'Stand facing box at appropriate height. Jump up landing softly on box with both feet. Step down and repeat. Focus on landing mechanics.',
   NULL),

  (142, 'Broad Jumps', 'Standing Long Jump',
   'Stand with feet hip-width apart. Jump forward as far as possible, landing softly. Focus on explosive hip extension and safe landing.',
   NULL),

  (143, 'Jump Squats', 'Plyometric Squats',
   'Perform bodyweight squat then explode up into jump. Land softly and immediately go into next squat. Keep movements explosive and controlled.',
   NULL),

  (144, 'Battle Ropes', 'Training Ropes',
   'Hold ends of heavy rope with athletic stance. Create waves by alternating arm movements or simultaneous slams. Maintain core engagement throughout.',
   NULL),

  (145, 'Tire Flips', 'Large Tire Flips',
   'Squat down to tire with hands underneath. Drive up explosively while pushing tire over. Step forward and repeat. Full body power movement.',
   NULL),

  (146, 'Sled Push', 'Prowler Push',
   'Load sled with appropriate weight. Push sled forward with arms extended, driving through legs. Maintain forward lean and quick steps.',
   NULL),

  (147, 'Sled Pull', 'Rope Sled Pull',
   'Attach rope to loaded sled. Pull sled toward you hand over hand while walking backward. Keep core engaged and maintain good posture.',
   NULL),

  -- Machine Variations & Isolation
  (148, 'Leg Press - Single Leg', 'Unilateral Leg Press',
   'Use leg press machine with one leg at a time. Focus on full range of motion and control. Excellent for addressing imbalances.',
   NULL),

  (149, 'Seated Leg Curl', 'Seated Hamstring Curl',
   'Sit in seated leg curl machine with pads behind calves. Curl heels down toward glutes. Return with control. Different angle than lying version.',
   NULL),

  (150, 'Standing Leg Curl', 'Single Leg Curl Machine',
   'Stand holding machine for support, curl one leg at a time. Focus on squeezing hamstring at top of movement.',
   NULL),

  (151, 'Smith Machine Calf Raises', 'Smith Calf Raises',
   'Use Smith machine bar across shoulders. Perform calf raises with added stability from machine. Good for heavy loading.',
   NULL),

  (152, 'Cable Reverse Flyes', 'Cable Rear Delt Flyes',
   'Set cables at chest height with handles crossed. Pull handles apart while squeezing rear delts. Keep slight elbow bend throughout.',
   NULL),

  -- Conditioning & Cardio Strength
  (153, 'Rowing Machine', 'Concept 2 Rowing',
   'Sit on rowing machine with feet secured. Pull handle to chest while extending legs. Return by extending arms first, then bending knees.',
   NULL),

  (154, 'Assault Bike', 'Air Bike',
   'Sit on assault bike and pedal while moving arms. Resistance increases with effort. Excellent for conditioning and full body cardio.',
   NULL),

  (155, 'Ski Erg', 'Skiing Machine',
   'Stand at ski erg machine. Pull handles down in skiing motion while engaging core. Return handles with control.',
   NULL),

  -- Advanced Core
  (156, 'Windshield Wipers', 'Hanging Windshield Wipers',
   'Hang from pull-up bar with legs raised to 90 degrees. Rotate legs side to side like windshield wipers. Keep shoulders stable.',
   NULL),

  (157, 'L-Sits', 'L-Sit Hold',
   'Support body on parallel bars or dip station. Lift legs until parallel to ground, forming L-shape. Hold position while breathing normally.',
   NULL),

  (158, 'Russian Twists - Weighted', 'Weighted Russian Twists',
   'Sit with knees bent holding weight. Lean back and rotate weight side to side, tapping ground. Keep chest up and core engaged.',
   NULL),

  -- Grip & Forearm Specific
  (159, 'Plate Pinches', 'Weight Plate Pinches',
   'Hold weight plates between thumb and fingers. Hold for time or walk with plates. Excellent for grip strength development.',
   NULL),

  (160, 'Dead Hangs', 'Hanging Hold',
   'Hang from pull-up bar with overhand grip. Hold for time while maintaining shoulder stability. Builds grip strength and shoulder health.',
   NULL),

  -- Flexibility & Mobility Integration
  (161, 'Dynamic Warm-up Squats', 'Bodyweight Movement Prep',
   'Perform bodyweight squats with focus on full range of motion and movement quality. Part of warm-up routine.',
   NULL),

  (162, 'Leg Swings', 'Dynamic Leg Swings',
   'Hold support and swing leg forward and back, then side to side. Loosens hips and prepares for training. Keep movements controlled.',
   NULL),

  (163, 'Arm Circles', 'Shoulder Circles',
   'Extend arms to sides and make circular motions. Start small and increase size. Reverse direction. Warms up shoulders before training.',
   NULL),

  -- Advanced Variations
  (164, 'Deficit Deadlifts', 'Elevated Deadlifts',
   'Stand on platform or plates to increase range of motion. Perform deadlift with greater depth. Increases flexibility and strength demands.',
   NULL),

  (165, 'Pause Bench Press', 'Competition Bench Press',
   'Perform bench press with 1-2 second pause on chest. Eliminates bounce and increases strength off chest. Used in powerlifting.',
   NULL),

  (166, 'Tempo Squats', 'Slow Eccentric Squats',
   'Perform squats with controlled tempo, usually 3-4 seconds down, pause, then up. Increases time under tension.',
   NULL),

  (167, 'Pin Squats', 'Anderson Squats',
   'Set safety pins at desired depth in squat rack. Start squat from bottom position on pins. Builds strength out of bottom position.',
   NULL),

  (168, 'Floor Press', 'Barbell Floor Press',
   'Lie on floor with barbell at chest level. Press bar up until arms are extended. Floor limits range of motion, focusing on lockout strength.',
   NULL),

  -- Specialty Equipment
  (169, 'GHD Sit-ups', 'Glute Ham Developer Sit-ups',
   'Sit in GHD machine with feet secured. Lower back while keeping legs straight. Return to sitting position using abs and hip flexors.',
   NULL),

  (170, 'GHD Back Extensions', 'Glute Ham Developer Extensions',
   'Position in GHD with hips at pad. Lower torso while keeping legs straight. Raise back up using glutes and hamstrings.',
   NULL),

  (171, 'Reverse Hypers', 'Reverse Hyperextensions',
   'Lie face down on reverse hyper machine. Swing legs up behind you while squeezing glutes. Lower with control.',
   NULL),

  -- Additional Stretching & Recovery
  (172, 'Couch Stretch', 'Hip Flexor Stretch',
   'Place rear foot on couch or bench, front foot on ground in lunge position. Push hips forward to stretch hip flexors. Hold and breathe deeply.',
   NULL),

  (173, 'Seated Forward Fold', 'Hamstring Stretch',
   'Sit with legs extended. Fold forward reaching toward toes. Keep spine long and breathe deeply. Stretches hamstrings and lower back.',
   NULL),

  (174, 'Doorway Chest Stretch', 'Pec Stretch',
   'Place forearm against doorway with elbow at 90 degrees. Step forward to stretch chest and front shoulder. Hold and repeat other side.',
   NULL),

  (175, 'Thread the Needle', 'Thoracic Spine Mobility',
   'Start on hands and knees. Thread one arm under body and through to other side. Return and reach same arm toward ceiling. Mobilizes thoracic spine.',
   NULL);

  -- Specialty & Sport-Specific
  INSERT INTO Exercise(id, name, aliases, description, video_link) VALUES
  (176, 'Medicine Ball Slams', 'Med Ball Slams',
   'Hold medicine ball overhead with feet shoulder-width apart. Slam ball down with full force using core and arms. Pick up and repeat. Explosive full body movement.',
   NULL),

  (177, 'Medicine Ball Throws', 'Chest Pass Throws',
   'Hold medicine ball at chest. Explosively throw ball forward to partner or wall. Catch and repeat. Develops power and coordination.',
   NULL),

  (178, 'Sledgehammer Swings', 'Tire Hits',
   'Hold sledgehammer and swing down to hit tire. Use full body rotation and core engagement. Alternate overhead and diagonal swings.',
   NULL),

  (179, 'Atlas Stone Lifts', 'Stone Loading',
   'Squat down to atlas stone, wrap arms around it. Lift stone to chest then load onto platform. Extremely challenging full body exercise.',
   NULL),

  (180, 'Yoke Walk', 'Yoke Carry',
   'Position under loaded yoke bar across shoulders. Stand and walk forward with heavy load. Maintain upright posture and quick steps.',
   NULL);

